<div class="login-container">
    <div class="container">
        <h2 style="text-align: center; margin-bottom: 1.5rem;">Login to WVSU-BSIS EduTrack</h2>
        
        <% if (error) { %>
            <div class="error-message">
                <%= error %>
            </div>
        <% } %>
        
        <form action="/auth/login" method="POST" class="login-form">
            <div class="form-group">
                <label for="userId">User ID:</label>
                <input type="text" id="userId" name="userId" required placeholder="e.g. 2025M0701">
            </div>
            
            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required placeholder="Enter your password">
            </div>
            
            <div style="text-align: center;">
                <button type="submit" class="btn">Login</button>
            </div>
        </form>
        
        <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #eee;">
            <h3>Default Credentials:</h3>
            <p><strong>Admin:</strong> ID: 2025M0701, Password: admin123</p>
            <p><strong>Student:</strong> Any student ID, Password: student123</p>
        </div>
    </div>
</div>