<div class="content-wrapper">
    <div class="container">
        <h1>Class Report</h1>
        <p>Generated by: <%= user.name %></p>
        
        <div style="text-align: right; margin-bottom: 1rem;">
            <button onclick="printReport()" class="btn">Print Report</button>
            <button onclick="exportToPDF('class')" class="btn" style="margin-left: 0.5rem; background-color: #4CAF50;">Export to PDF</button>
        </div>
        
        <div style="border: 1px solid #ddd; padding: 2rem; margin-bottom: 2rem;">
            <h2 style="text-align: center; margin-bottom: 1rem;">WVSU-BSIS EduTrack Class Report</h2>
            <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                <div>
                    <p><strong>Class:</strong> BS Information Systems - Section 1A</p>
                    <p><strong>Total Students:</strong> <%= students.length %></p>
                </div>
                <div>
                    <p><strong>Date Generated:</strong> <%= new Date().toLocaleDateString() %></p>
                    <p><strong>Generated By:</strong> <%= user.name %></p>
                </div>
            </div>
            
            <div class="table-container">
                <h3>Student List</h3>
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach(student => { %>
                            <tr>
                                <td><%= student.id %></td>
                                <td><%= student.name %></td>
                                <td><%= student.role %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            
            <div class="table-container" style="margin-top: 2rem;">
                <h3>Subjects by Semester</h3>
                <h4>First Year - First Semester</h4>
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Lec</th>
                            <th>Lab</th>
                            <th>Units</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% subjects.first_year_first_semester.forEach(subject => { %>
                            <tr>
                                <td><%= subject.code %></td>
                                <td><%= subject.name %></td>
                                <td><%= subject.lec %></td>
                                <td><%= subject.lab %></td>
                                <td><%= subject.units %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
                
                <h4>First Year - Second Semester</h4>
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Lec</th>
                            <th>Lab</th>
                            <th>Units</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% subjects.first_year_second_semester.forEach(subject => { %>
                            <tr>
                                <td><%= subject.code %></td>
                                <td><%= subject.name %></td>
                                <td><%= subject.lec %></td>
                                <td><%= subject.lab %></td>
                                <td><%= subject.units %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
                
                <h4>Second Year - First Semester</h4>
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Lec</th>
                            <th>Lab</th>
                            <th>Units</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% subjects.second_year_first_semester.forEach(subject => { %>
                            <tr>
                                <td><%= subject.code %></td>
                                <td><%= subject.name %></td>
                                <td><%= subject.lec %></td>
                                <td><%= subject.lab %></td>
                                <td><%= subject.units %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
                
                <h4>Second Year - Second Semester</h4>
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Lec</th>
                            <th>Lab</th>
                            <th>Units</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% subjects.second_year_second_semester.forEach(subject => { %>
                            <tr>
                                <td><%= subject.code %></td>
                                <td><%= subject.name %></td>
                                <td><%= subject.lec %></td>
                                <td><%= subject.lab %></td>
                                <td><%= subject.units %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>