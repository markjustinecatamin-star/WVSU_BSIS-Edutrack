<div class="content-wrapper">
    <div class="container">
        <h1>My Grades</h1>
        <p>Welcome, <%= user.name %></p>
        
        <div class="table-container">
            <h2>First Year - First Semester</h2>
            <table>
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Units</th>
                        <th>Grade</th>
                    </tr>
                </thead>
                <tbody>
                    <% subjects.first_year_first_semester.forEach(subject => { %>
                        <tr>
                            <td><%= subject.code %></td>
                            <td><%= subject.name %></td>
                            <td><%= subject.units %></td>
                            <td>-</td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        
        <div class="table-container" style="margin-top: 2rem;">
            <h2>First Year - Second Semester</h2>
            <table>
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Units</th>
                        <th>Grade</th>
                    </tr>
                </thead>
                <tbody>
                    <% subjects.first_year_second_semester.forEach(subject => { %>
                        <tr>
                            <td><%= subject.code %></td>
                            <td><%= subject.name %></td>
                            <td><%= subject.units %></td>
                            <td>-</td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        
        <div class="table-container" style="margin-top: 2rem;">
            <h2>Second Year - First Semester</h2>
            <table>
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Units</th>
                        <th>Grade</th>
                    </tr>
                </thead>
                <tbody>
                    <% subjects.second_year_first_semester.forEach(subject => { %>
                        <tr>
                            <td><%= subject.code %></td>
                            <td><%= subject.name %></td>
                            <td><%= subject.units %></td>
                            <td>-</td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        
        <div class="table-container" style="margin-top: 2rem;">
            <h2>Second Year - Second Semester</h2>
            <table>
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Units</th>
                        <th>Grade</th>
                    </tr>
                </thead>
                <tbody>
                    <% subjects.second_year_second_semester.forEach(subject => { %>
                        <tr>
                            <td><%= subject.code %></td>
                            <td><%= subject.name %></td>
                            <td><%= subject.units %></td>
                            <td>-</td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>