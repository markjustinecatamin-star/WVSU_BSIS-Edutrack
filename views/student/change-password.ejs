<div class="content-wrapper">
    <div class="container">
        <h1>Change Password</h1>
        <p>Welcome, <%= user.name %></p>
        
        <% if (error) { %>
            <div class="error-message">
                <%= error %>
            </div>
        <% } %>
        
        <% if (success) { %>
            <div class="success-message">
                <%= success %>
            </div>
        <% } %>
        
        <form action="/student/change-password" method="POST" class="login-form" onsubmit="return validateForm('passwordForm')">
            <div class="form-group">
                <label for="currentPassword">Current Password:</label>
                <input type="password" id="currentPassword" name="currentPassword" required>
            </div>
            
            <div class="form-group">
                <label for="newPassword">New Password:</label>
                <input type="password" id="newPassword" name="newPassword" required 
                       oninput="updatePasswordStrength('newPassword', 'passwordStrength')">
                <div id="passwordStrength" style="margin-top: 0.5rem; font-size: 0.9rem;"></div>
            </div>
            
            <div class="form-group">
                <label for="confirmPassword">Confirm New Password:</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required>
            </div>
            
            <div style="text-align: center;">
                <button type="submit" class="btn" id="passwordForm">Change Password</button>
            </div>
        </form>
    </div>
</div>